rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection testing endpoint for boot verification
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile collection
    match /users/{userId} {
      allow read: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && (!('role' in request.resource.data) || request.resource.data.get('role', 'user') == 'user');
      // A user may edit their own profile but can never grant themselves admin privileges.
      allow update: if isOwner(userId)
        && isValidId(userId)
        && (!('role' in request.resource.data)
          || request.resource.data.get('role', null) == resource.data.get('role', null));
      allow delete: if isOwner(userId) && isValidId(userId);

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId) && isValidId(taskId);
      }

      // Habits subcollection
      match /habits/{habitId} {
        allow read, write: if isOwner(userId) && isValidId(habitId);
      }

      // Growth goals subcollection
      match /goals/{goalId} {
        allow read, write: if isOwner(userId) && isValidId(goalId);
      }

      // Gemini chat transcripts subcollection
      match /chats/{chatId} {
        allow read, write: if isOwner(userId) && isValidId(chatId);
      }
    }
  }
}
